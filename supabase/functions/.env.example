# Edge function secrets for local dev (supabase functions serve --env-file supabase/functions/.env)
# Copy to supabase/functions/.env and fill in DEV values only. Never commit the real .env.

# Supabase. With `supabase start` these come from the local stack, not production.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Date plan generation (generate-date-plan). Use your own dev keys with spend caps.
OPENAI_API_KEY=
GOOGLE_PLACES_API_KEY=

# Optional. Only needed if you're working on these functions.
LASTFM_API_KEY=            # generate-playlist
RESEND_API_KEY=            # emails
ADMIN_NOTIFICATION_EMAIL=
TWILIO_ACCOUNT_SID=        # send-date-plan-sms
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
APPLE_BUNDLE_ID=com.yourdategenie.app
