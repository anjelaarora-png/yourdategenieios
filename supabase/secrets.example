# Supabase Edge Function secrets (project: jhpwacmsocjmzhimtbxj)
# Set via Dashboard → Project Settings → Edge Functions → Secrets
# or CLI: supabase secrets set KEY=value --project-ref jhpwacmsocjmzhimtbxj
#
# NEVER commit real values to git.

# --- AI (OpenAI) — server-side only; NOT in iOS ---
# Used by: generate-date-plan, generate-more-gifts, rewrite-love-note
OPENAI_API_KEY=sk-...

# --- Google Places + Geocoding — server-side venue verification ---
# Used by: generate-date-plan (validateAllStops, geocodeAddress)
# Same Google Cloud key as iOS/web is OK; restrict by API (Places + Geocoding).
GOOGLE_PLACES_API_KEY=...

# --- Last.fm — playlist generation only ---
# Used by: generate-playlist
# Get key: https://www.last.fm/api/account/create
LASTFM_API_KEY=...

# --- Apple subscriptions (StoreKit 2) ---
# Used by: validate-receipt, apple-notifications-v2
APPLE_BUNDLE_ID=com.yourdategenie.app

# --- Email (Resend) ---
# Used by: send-welcome-email, send-date-plan-email, notify-new-signup, submit-report
RESEND_API_KEY=re_...
ADMIN_NOTIFICATION_EMAIL=hello@yourdategenie.com

# --- SMS (optional — send-date-plan-sms) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# --- Auto-injected by Supabase (do not set manually unless self-hosting) ---
# SUPABASE_URL
# SUPABASE_ANON_KEY
# SUPABASE_SERVICE_ROLE_KEY
